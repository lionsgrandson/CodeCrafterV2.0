# CodeCrafter static/SSR-prerender Apache config

Options -Indexes
DirectoryIndex index.html

ErrorDocument 401 /401.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical domain.
  RewriteCond %{HTTP_HOST} ^www\.mosheschwartzberg\.com$ [NC]
  RewriteRule ^(.*)$ https://mosheschwartzberg.com/$1 [R=301,L]

  # HTTPS redirect for Apache environments that are not already handled upstream.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Friendly status page URLs.
  RewriteRule ^(200|401|403|404)/?$ /$1.html [L]

  # Obsolete non-page URLs previously seen in search results.
  RewriteRule ^favicon\.svg$ - [R=410,L]
  RewriteRule ^manifest\.json$ - [R=410,L]

  # Canonicalize the historical mixed-case Rainbow URL to the revived case study.
  RewriteRule ^portfolio/Rainbow-asd/?$ /portfolio/rainbow-asd/ [R=301,L,NE]

  # Legacy indexed URLs. Keep these aligned with server.ts and public/_redirects.
  RewriteRule ^blog\.html$ /websites/ [R=301,L,NE,NC]
  RewriteRule ^index\.html$ / [R=301,L,NE,NC]
  RewriteRule ^portfolio/index\.html$ /portfolio/ [R=301,L,NE,NC]
  RewriteRule ^about/index\.html$ /about/ [R=301,L,NE,NC]
  RewriteRule ^blog/free-domains-new-era-internet/?$ /websites/ [R=301,L,NE,NC]
  RewriteRule ^blog/perfect-lighthouse/?$ /websites/ [R=301,L,NE,NC]
  RewriteRule ^blog/backend-code-horror/?$ /custom-software/ [R=301,L,NE,NC]
  RewriteRule ^blog/5-website-must-have/?$ /websites/ [R=301,L,NE,NC]
  RewriteRule ^portfolio/idf-tech-maintenance-corps-v2/?$ /portfolio/ [R=301,L,NE,NC]
  RewriteRule ^portfolio/nexa-automations-glass-ui/?$ /automation/ [R=301,L,NE,NC]

  # Keep real files and directories untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing paths should use the static 404 page with a real 404 status.
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "upgrade-insecure-requests"

  # Crawlers may fetch these resources to render the site, but they should never
  # become standalone search results.
  <FilesMatch "\.(?:css|js|mjs|map|json|webmanifest)$">
    Header always set X-Robots-Tag "noindex"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|ico|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:html|txt|xml)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
